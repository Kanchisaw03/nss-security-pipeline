            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('researcherToken', jsonData.token);",
                  "    console.log('✓ Researcher token saved');",
                  "} else {",
                  "    console.log('⚠ Researcher login failed:', pm.response.text());",
                  "}"
