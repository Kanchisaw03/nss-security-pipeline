{
  "info": {
    "name": "Safe Data Access Platform - Security Enhanced API",
    "description": "Complete API collection for the 9-layer defense-in-depth privacy platform. Includes all new security modules: cryptography, anonymization, differential privacy, risk scoring, zero trust, consent engine, query firewall, audit chain, and release pipeline.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "researcherToken", "value": "" },
    { "key": "dataset_id", "value": "" },
    { "key": "consent_id", "value": "" },
    { "key": "release_id", "value": "" },
    { "key": "execution_id", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health & System Status",
      "item": [
        {
          "name": "GET /health - Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Health check passes', function() {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.equal('healthy');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "GET /api/status - API Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "status"]
            }
          },
          "response": []
        },
        {
          "name": "GET /api/security/status - Security Layer Status (No Auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This should return 401 without auth",
                  "pm.test('Security status requires authentication', function() {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/security/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "security", "status"]
            }
          },
          "response": []
        },
        {
          "name": "GET /api/security/status - Security Layer Status (With Auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This should return 200 with auth",
                  "pm.test('Security status works with authentication', function() {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.layers).to.be.an('object');",
