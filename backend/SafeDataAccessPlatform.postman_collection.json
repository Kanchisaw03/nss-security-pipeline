    {
      "name": "6. Differential Privacy Queries",
      "item": [
        {
          "name": "POST /api/dp/count/:releaseId - DP Count Query",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('DP count query successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.query).to.equal('count');",
                  "    pm.expect(jsonData.noisyValue).to.be.a('number');",
                  "    pm.expect(jsonData.privacyGuarantee).to.include('ε=');",
                  "    console.log('✓ DP Count:', jsonData.noisyValue, '(noise:', jsonData.noise + ')');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{researcherToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"epsilon\": 1.0,\n    \"filters\": {}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dp/count/{{release_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dp", "count", "{{release_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "POST /api/dp/sum/:releaseId - DP Sum Query",
          "event": [
            {
              "listen": "test",
