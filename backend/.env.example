# Safe Data Access Platform - Environment Configuration
# Copy this file to .env and update with your production values

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==========================================
# CRYPTOGRAPHY (CRITICAL - CHANGE IN PRODUCTION)
# ==========================================
# Master key for KEK derivation (minimum 32 characters)
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=change-this-to-a-secure-32-char-secret-key

# Secret for HMAC tokenization (minimum 32 characters)
# Generate with: openssl rand -base64 32
HASH_SECRET=change-this-to-another-secure-32-char-secret

# JWT Configuration
JWT_SECRET=your-jwt-secret-minimum-32-characters-long
JWT_EXPIRES_IN=24h

# ==========================================
# PRIVACY CONFIGURATION
# ==========================================
# Default k-anonymity threshold
DEFAULT_K_ANONYMITY=5

# Default l-diversity threshold
DEFAULT_L_DIVERSITY=2

# Default t-closeness threshold
DEFAULT_T_CLOSENESS=0.2

# Default epsilon for differential privacy
DEFAULT_DP_EPSILON=1.0

# Maximum allowed epsilon
MAX_DP_EPSILON=10.0

# Maximum risk score for release (0-100)
MAX_RISK_SCORE=60

# ==========================================
# AUDIT CONFIGURATION
# ==========================================
# Enable audit persistence to disk
AUDIT_PERSISTENCE=true

# Path for audit log storage
AUDIT_PATH=./audit-logs

# ==========================================
# FIREWALL CONFIGURATION
# ==========================================
# Minimum records for query results
MIN_K_RECORDS=5

# Max queries per minute
MAX_QUERIES_PER_MINUTE=20

# Block duration in milliseconds (30 minutes)
BLOCK_DURATION_MS=1800000

# ==========================================
# SECURITY MIDDLEWARE
# ==========================================
# Rate limiting window (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# PIPELINE CONFIGURATION
# ==========================================
# Enable/disable pipeline stages
PIPELINE_DECRYPT=true
PIPELINE_CLASSIFY=true
PIPELINE_RISK_ASSESS=true
PIPELINE_ANONYMIZE=true
PIPELINE_VALIDATE=true
PIPELINE_ENCRYPT=true
PIPELINE_STORE=true
